# ===================================================
# VERITAS ENVIRONMENT CONFIGURATION TEMPLATE
# ===================================================

# Database (Local SQLite)
DATABASE_URL=file:../db/custom.db

# Authentication & Security
JWT_SECRET=your-secure-random-jwt-secret-key-min-32-chars
ADMIN_SECRET_KEY=admin-secret-access-link-cbit-2026

# Ollama Local LLM Configuration (100% Local Inference)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:14b
LLM_PROVIDER=ollama

# SMTP Configuration for Two-Factor Authentication (2FA) OTPs
# (Leave blank for local console fallback logging during development)
# -------------------------------------------------------------
# Brevo (Recommended):
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=587
#   SMTP_USER=your-brevo-login-email@smtp-brevo.com
#   SMTP_PASS=your-brevo-smtp-key
#   SMTP_FROM="Veritas Security" <your-verified-email@domain.com>
# -------------------------------------------------------------
# Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=your-email@gmail.com
#   SMTP_PASS=your-google-16-char-app-password
#   SMTP_FROM="Veritas Security" <your-email@gmail.com>
# -------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Veritas 2FA Security" <security@veritas.local>

